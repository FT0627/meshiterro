        <%= form_with model: post_image do |f| %>
          <%= f.file_field :image, accept: "image/*", class: "w-100" %>
          <div class="input-group mb-3 mt-4">
            <div class="input-group-prepend">
              <span class="input-group-text" aria-hidden="true"><i class="fas fa-building"></i></span>
            </div>
            <%= f.text_field :shop_name, class: "form-control", placeholder: "ショップ名" %>
          </div>
          <div class="input-group mb-3 mt-4">
            <div class="input-group-prepend">
              <span class="input-group-text" aria-hidden="true"><i class="fas fa-tenge-sign"></i></span>
            </div>
            <%= text_field_tag :zipcode, nil, class: "form-control", placeholder: "郵便番号" %>
          </div>
          <div class="input-group mb-3 mt-4">
            <div class="input-group-prepend">
              <span class="input-group-text" aria-hidden="true"><i class="fas fa-location-dot"></i></span>
            </div>
            <%= f.text_field :address, class: "form-control", placeholder: "住所" %>
          </div>
          <%= f.text_area :caption, class: "form-control", rows: "3", placeholder: "コメントここに" %>
          <% if f.object.new_record? %>
            <%= f.submit '投稿', :name => 'post', class: "btn btn-lg btn-block btn-info mt-4" %>
            <%= f.submit '下書きに保存', :name => 'draft', class: "btn btn-lg btn-block btn-info mt-4" %>
          <% else %>
            <%= f.submit '更新', class: "btn btn-lg btn-block btn-info mt-4" %>
          <% end %>
        <% end %>
