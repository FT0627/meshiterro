<div>
  <h3><%= @user.name %></h3>
  <%= image_tag @user.get_profile_image(100,100) %>
  <% if @user.id == current_user.id %>
    <p><%= link_to "プロフィール編集", edit_user_path(@user) %></p>
  <% end %>
  <%= link_to "下書き一覧", confirm_user_path(@user) %>
</div>

<%= render 'public/post_images/list', post_images: @post_images %>